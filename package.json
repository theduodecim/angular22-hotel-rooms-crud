{
  "name": "hotel-crud-shell",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve hotel-crud-shell --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:shell": "ng serve hotel-crud-shell --port 4200",
    "start:remote": "ng serve rooms-remote --port 4201",
    "start:mf": "concurrently \"npm run start:shell\" \"npm run start:remote\"",
    "build:shell": "ng build hotel-crud-shell",
    "build:remote": "ng build rooms-remote"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "angular-in-memory-web-api": "^0.22.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "@angular-architects/native-federation": "^22.1.0",
    "concurrently": "^9.2.1"
  }
}
